--- tests/sys/netipsec/tunnel/Makefile.orig
+++ tests/sys/netipsec/tunnel/Makefile
@@ -11,7 +11,8 @@
 		aesni_aes_cbc_256_hmac_sha2_256 \
 		aesni_aes_gcm_128 \
