+        if (r->start < tail_sc->sc_range.end) {
+            rsize = tail_sc->sc_range.end - r->start;
+
+            if (fs->cleanse)
+                OPENSSL_cleanse(deconst(*data), UINT64_TO_SIZE_T(rsize));
+
+            *data += rsize;
+
+            r->start = tail_sc->sc_range.end;
+        }
