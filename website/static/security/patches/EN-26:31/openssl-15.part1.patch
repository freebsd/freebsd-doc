-                || ($cnt == $number && ($qualifier ne $newqual
-                                           || $qualifier eq ""))) {
-            print STDERR "Invalid ordinal detected: ".$tokens[1]."\n";
-            $ret = 0;
-            last;
-        }
-        $cnt = $tokens[1];
-        $qualifier = $newqual;
-        $lastfunc = $tokens[0];
-    }
-    close($fh);
-
-    return $ret;
-}
