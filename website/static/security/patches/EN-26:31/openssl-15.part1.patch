+}
+
+static int test_rbt_find_remove(void)
+{
+    unsigned int i;
+    TEST_RBT_T *node_rbt, *removed_rbt;
+    TEST_RBT_T key_rbt;
+
+    if (test_rbt_insert() == 0)
