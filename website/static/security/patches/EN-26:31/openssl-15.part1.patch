-            last;
-        }
-        if ($tokens[3] eq "NOEXIST") {
-            #Ignore this line
-            next;
-        }
-        #Some ordinals can be repeated, e.g. if one is VMS and another is !VMS
-        $newqual = $tokens[4];
-        $newqual =~ s/!//g;
-        my $number = $tokens[1];
-        $number = $cnt + 1 if $number eq '?';
-        $number = $cnt if $number eq '?+';
