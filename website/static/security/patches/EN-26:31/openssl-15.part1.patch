-sub compare1stline_re {
-    my ($cmdarray, $regexp) = @_;
-    my @lines = run(app($cmdarray), capture => 1);
-
-    return $lines[0] =~ m|$regexp|;
-}
-
-sub compare1stline {
-    my ($cmdarray, $str) = @_;
-    my @lines = run(app($cmdarray), capture => 1);
-
-    return $lines[0] =~ m|^\Q${str}\E\R$|;
-}
