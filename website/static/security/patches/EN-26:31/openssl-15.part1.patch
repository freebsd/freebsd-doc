+        node_rbt = OSSL_RBT_FIND(ossl_rbt, &rbt_head, &key_rbt);
+        if (!TEST_ptr_eq(node_rbt, NULL)) {
+            TEST_info("%s %s(%p) still found after being removed @ %u",
+                OPENSSL_FUNC, node_rbt->rbt_data, (void *)node_rbt, i);
+            return 0;
