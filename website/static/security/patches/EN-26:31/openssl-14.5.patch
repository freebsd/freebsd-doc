-            # normally write that one, and it is allowed as unsolicited in the
-            # ServerHello
-            $message->set_extension(TLSProxy::Message::EXT_CRYPTOPRO_BUG_EXTENSION, "");
-            $message->dupext(TLSProxy::Message::EXT_CRYPTOPRO_BUG_EXTENSION);
-            $message->repack();
