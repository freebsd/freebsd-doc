-
-    diag "Comparing $smcont with $opts{output}.txt";
-    return compare_text($smcont, "$opts{output}.txt") == 0;
-}
-
-sub zero_compare {
-    my %opts = @_;
-
-    diag "Checking for zero-length file";
-    return (-e "$opts{output}.txt" && -z "$opts{output}.txt");
-}
