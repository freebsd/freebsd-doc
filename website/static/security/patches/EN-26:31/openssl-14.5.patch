-                    $sigalg = pack "C2", 0x00, 0x00;
-                } elsif ($testtype == NO_KNOWN_SIG_ALGS) {
-                    $sigalg = pack "C4", 0x00, 0x02, 0xff, 0xff;
-                } elsif ($testtype == NO_PSS_SIG_ALGS) {
-                    #No PSS sig algs - just send rsa_pkcs1_sha256
