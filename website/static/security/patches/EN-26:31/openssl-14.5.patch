-                } else {
-                    #PSS sig algs only - just send rsa_pss_rsae_sha256
-                    $sigalg = pack "C4", 0x00, 0x02, 0x08, 0x04;
-                }
-                $message->set_extension(TLSProxy::Message::EXT_SIG_ALGS, $sigalg);
