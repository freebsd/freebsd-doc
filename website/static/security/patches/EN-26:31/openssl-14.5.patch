-      tests  => [ { providers => [] },
-                  { },
-                  { args      => [ '-property', 'provider=default' ],
-                    message   => 'using property "provider=default"' },
-                  { args      => [ '-property', 'provider!=fips' ],
-                    message   => 'using property "provider!=fips"' },
-                  { args      => [ '-property', 'provider!=default', '-fetchfail' ],
-                    message   =>
