-        @nm_lines =
-            sort
-            ( map {
-                  # Drop the first space and everything following it
-                  s| .*||;
-                  # Drop OpenSSL dynamic version information if there is any
-                  s|\@\@.+$||;
-                  # Return the result
-                  $_
-              }
-              # Drop any symbol starting with a double underscore, they
