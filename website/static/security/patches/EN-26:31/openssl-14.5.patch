-        my $bldtop = bldtop_dir();
-        my @def_lines;
-        indir $bldtop => sub {
-            my $mkdefpath = srctop_file("util", "mkdef.pl");
-            my $libnumpath = srctop_file("util", "lib$libname.num");
-            @def_lines = map { s|\R$||; $_ } `$^X $mkdefpath --ordinals $libnumpath --name $libname --OS linux 2> /dev/null`;
