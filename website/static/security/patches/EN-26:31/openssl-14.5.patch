-    $bad_padding_offset = $offset;
-    $fatal_alert = 0;
-    $proxy->clearClient();
-    $proxy->clientflags("-no_tls1_3");
-    $proxy->clientstart();
-    ok($fatal_alert, "Invalid padding byte $bad_padding_offset");
