-# Get the value of the lastUpdate or nextUpdate field from a CRL
-sub crl_field {
-    my ($crl_path, $field_name) = @_;
-
-    my @out = run(
-        app(['openssl',
-             'crl',
-             '-in', $crl_path,
-             '-noout',
-             '-' . lc($field_name),
-        ]),
-        capture => 1,
-        statusvar => \my $exit,
-    );
-    ok($exit, "CRL $field_name field retrieved");
