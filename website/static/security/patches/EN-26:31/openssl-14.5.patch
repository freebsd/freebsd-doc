-        1,
-        0,
-        1,
-        1,
-        $byte,
-        $byte
-    );
-    push @{$records}, $record;
-
-    # And finally the description (Unexpected message) in a third record
-    $byte = pack('C', TLSProxy::Message::AL_DESC_UNEXPECTED_MESSAGE);
-    $record = TLSProxy::Record->new(
-        0,
-        TLSProxy::Record::RT_ALERT,
-        TLSProxy::Record::VERS_TLS_1_2,
-        1,
-        0,
-        1,
-        1,
-        $byte,
-        $byte
