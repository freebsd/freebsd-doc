-# This collects specific use cases, and tests our handling
-
-use File::Spec::Functions;
-use File::Copy;
-use MIME::Base64;
-use OpenSSL::Test qw(:DEFAULT srctop_file srctop_dir bldtop_file bldtop_dir
-                     data_file);
