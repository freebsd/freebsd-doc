+	switch (cmd) {
+	case OCS_ECD_HELPER_BAR_READ8:
+	case OCS_ECD_HELPER_BAR_WRITE8:
+	case OCS_ECD_HELPER_CFG_READ8:
+	case OCS_ECD_HELPER_CFG_WRITE8:
