+	case OCS_ECD_HELPER_BAR_READ16:
+	case OCS_ECD_HELPER_BAR_WRITE16:
+	case OCS_ECD_HELPER_CFG_READ16:
+	case OCS_ECD_HELPER_CFG_WRITE16:
+		return (sizeof(uint16_t));
+	default:
+		return (sizeof(uint32_t));
+	}
+}
