#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1217
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1233
#, no-wrap
msgid "weekly – Sunday at 12:00 UTC"
msgstr ""

#. type: Table
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1211
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1219
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1234
#, no-wrap
