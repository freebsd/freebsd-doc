"Copying config 90c4936754 done   |\n"
"Writing manifest to image destination\n"
"Loaded image: localhost/freebsd-runtime:{rel-latest}-RELEASE-amd64\n"
msgstr ""

#. type: delimited block - 4
#: documentation/content/en/books/handbook/containers/_index.adoc:324
#, no-wrap
msgid ""
"# podman load -i=$OCIBASE/FreeBSD-{rel-latest}-RELEASE-amd64-container-image-notoolchain.txz\n"
