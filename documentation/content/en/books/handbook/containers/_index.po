"Writing manifest to image destination\n"
"Loaded image: localhost/freebsd-notoolchain:{rel-latest}-RELEASE-amd64\n"
msgstr ""

#. type: delimited block - 4
#: documentation/content/en/books/handbook/containers/_index.adoc:331
#, no-wrap
msgid ""
"# podman load -i=$OCIBASE/FreeBSD-{rel-latest}-RELEASE-amd64-container-image-toolchain.txz\n"
