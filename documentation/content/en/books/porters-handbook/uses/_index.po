#, no-wrap
msgid "`sudo`"
msgstr ""

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:2804
msgid "Adds a run time dependecy on package:security/sudo[]."
msgstr ""

#. type: Title ==
