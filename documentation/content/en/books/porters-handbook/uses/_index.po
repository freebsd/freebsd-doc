#. type: Labeled list
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:692
#, no-wrap
msgid "`MIX_EXTRA_APPS`"
msgstr ""

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:694
