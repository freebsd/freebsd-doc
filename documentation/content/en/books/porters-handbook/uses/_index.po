msgstr ""

#. type: Labeled list
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:674
#, no-wrap
msgid "`MIX_REWRITE`"
msgstr ""

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:676
msgid "Automatically replace Mix dependencies with code paths"
msgstr ""

#. type: Labeled list
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:676
#, no-wrap
msgid "`MIX_BUILD_DEPS`"
msgstr ""

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:678
msgid ""
"List of `BUILD_DEPENDS` in category/portname format (commonly referenced to "
"as \"deps\" in Erlang and Elixir)"
msgstr ""

#. type: Labeled list
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:678
#, no-wrap
msgid "`MIX_RUN_DEPS`"
msgstr ""

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:680
